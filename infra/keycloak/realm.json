{
  "realm": "app",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "dispatcher"
      },
      {
        "name": "field"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "access.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}
